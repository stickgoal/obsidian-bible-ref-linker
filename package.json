{
  "name": "obsidian-bible-ref-linker",
  "version": "1.0.0",
  "description": "Render Chinese Bible references (e.g. 太 25:36) as Obsidian internal links [[马太福音 25#36]]. Range refs (太 25:36-38) link to the first verse.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types test-regex.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bible"
  ],
  "author": "Lucas",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@esbuild/win32-x64": "^0.17.3",
    "@types/node": "^20.12.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "^5.4.5"
  }
}
